---
import Base from "../layouts/Base.astro";
---
<Base title="Not found" noindex>
  <div class="wrap">
    <div class="page-head">
      <p class="num">404</p>
      <h1 style="margin-top: var(--s3)">Nothing here</h1>
      <p class="lede">The page may have moved when the site was rebuilt. Old <code>/blog/</code> links redirect to <code>/writing/</code>.</p>
      <p><a href="/writing/">Browse all writing</a></p>
    </div>
  </div>
</Base>
