---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostRow from "../components/PostRow.astro";
import { getPosts } from "../lib/site";
import { personJsonLd } from "../lib/article";

const posts = (await getPosts()).slice(0, 6);
const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---
<Base jsonLd={[personJsonLd()]}>
  <div class="wrap">
    <div class="home-intro">
      <h1><strong>Technology and security professional.</strong> I run business systems by day, and build security and intelligence tools through <a href="/work/">Covert Signals</a>, my independent project.</h1>
      <ul class="facts">
        <li><a href="/about/">About me</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>

    <div class="home-cols">
      <section aria-labelledby="h-writing">
        <div class="section-head"><span class="num" aria-hidden="true">01</span><h2 id="h-writing">Writing</h2><a class="more" href="/writing/">All writing</a></div>
        <ol class="rows">
          {posts.map((post) => <PostRow post={post} />)}
        </ol>
        {posts.length === 0 && <p class="empty">The first articles are on their way.</p>}
      </section>
      <div>
        <section aria-labelledby="h-work">
          <div class="section-head"><span class="num" aria-hidden="true">02</span><h2 id="h-work">Work</h2><a class="more" href="/work/" aria-label="More about my work">More</a></div>
          <ul class="work-list">
            {work.map((w) => (
              <li><div class="name"><a href={`/work/#${w.id}`}>{w.data.name}</a></div><p>{w.data.summary ?? w.data.description}</p></li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>
