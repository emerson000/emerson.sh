---
// Mock of the Notes tab ("the studio"): a list of notes, and the open note with
// a Write / Split / Read switch. Both the list and the switch are radio buttons
// styled with CSS, so the mock works without JavaScript. All text is invented.
import Mock from "./Mock.astro";

interface Props { id?: string }
const { id = "kn" } = Astro.props;

type Block = { h: string; p?: string; li?: string[]; ol?: string[] };
type Note = { id: string; kind: string; critical?: boolean; pinned: boolean; title: string; saved: string; blocks: Block[] };
const notes: Note[] = [
  {
    id: "n1", kind: "Finding", critical: true, pinned: true, saved: "10:42",
    title: "One certificate covers both lookalike domains",
    blocks: [
      { h: "What we found", p: "The TLS certificate on pellwood-recall.example also names pellwood-refunds.example." },
      { h: "Evidence", li: ["Two Certificate Issued For relationships on the case graph.", "The refund form is hosted on the second domain."] },
      { h: "Confidence", p: "Moderate. One party holds the key for both domains. The certificate does not say who." },
      { h: "So what", p: "Treat the emails and the refund page as one campaign. Report both domains together." },
    ],
  },
  {
    id: "n2", kind: "Report", pinned: true, saved: "16:05",
    title: "Daily summary",
    blocks: [
      { h: "Bottom line", p: "A lookalike domain sends fake recall emails. A second domain collects card numbers." },
      { h: "Key judgments", ol: ["The two domains are run together. Moderate confidence.", "The campaign started this week. Low confidence, one source."] },
      { h: "Gaps", li: ["Who registered the domains."] },
    ],
  },
  {
    id: "n3", kind: "Note", pinned: false, saved: "09:18",
    title: "Source check: the social post",
    blocks: [
      { h: "Notes", p: "The screenshot matches the article's description. The account is two years old and posts about camping." },
    ],
  },
];
const md = (b: Block) =>
  [`## ${b.h}`, b.p ?? "", ...(b.li ?? []).map((x) => `- ${x}`), ...(b.ol ?? []).map((x, i) => `${i + 1}. ${x}`)].filter(Boolean).join("\n");
const words = (n: Note) => n.blocks.map((b) => [b.h, b.p ?? "", ...(b.li ?? []), ...(b.ol ?? [])].join(" ")).join(" ").split(/\s+/).filter(Boolean).length;
---
<Mock crumb="Cases" sub="Pellwood refund lookalikes" tab="Notes" label="Notes studio mock" class="kn-fig">
  <div class="kn">
    <fieldset class="kn-list">
      <legend class="km-label">Open a note</legend>
      <p class="kn-group">Pinned to overview</p>
      {notes.filter((n) => n.pinned).map((n, i) => (
        <label class="kn-item"><input type="radio" name={`${id}-note`} value={n.id} checked={i === 0} />
          <span class="kn-it">{n.title}</span>
          <span class="kn-im">{n.kind}{n.critical && <> · <span class="kn-crit">Critical</span></>}</span>
        </label>
      ))}
      <p class="kn-group">Other notes</p>
      {notes.filter((n) => !n.pinned).map((n) => (
        <label class="kn-item"><input type="radio" name={`${id}-note`} value={n.id} />
          <span class="kn-it">{n.title}</span>
          <span class="kn-im">{n.kind}</span>
        </label>
      ))}
    </fieldset>

    <div class="kn-doc">
      <div class="kn-ctrl">
        <fieldset class="km-seg">
          <legend>View</legend>
          <label><input type="radio" name={`${id}-mode`} value="write" />Write</label>
          <label class="kn-split"><input type="radio" name={`${id}-mode`} value="split" checked />Split</label>
          <label><input type="radio" name={`${id}-mode`} value="read" />Read</label>
        </fieldset>
      </div>
      {notes.map((n) => (
        <article class="kn-note" data-note={n.id}>
          <p class="kn-meta"><span class="km-chip">{n.kind}</span>{n.critical && <span class="km-chip kn-critchip">Critical</span>}{n.pinned && <span class="km-chip">Pinned</span>}</p>
          <h3 class="kn-title">{n.title}</h3>
          <div class="kn-panes">
            <div class="kn-src"><p class="km-label">Source</p><pre>{n.blocks.map(md).join("\n\n")}</pre></div>
            <div class="kn-prev"><p class="km-label">Preview</p>
              {n.blocks.map((b) => (
                <>
                  <h4>{b.h}</h4>
                  {b.p && <p>{b.p}</p>}
                  {b.li && <ul>{b.li.map((x) => <li>{x}</li>)}</ul>}
                  {b.ol && <ol>{b.ol.map((x) => <li>{x}</li>)}</ol>}
                </>
              ))}
            </div>
          </div>
          <p class="kn-bar"><span>{words(n)} words</span><span>Saved {n.saved}</span></p>
        </article>
      ))}
    </div>
  </div>
  <Fragment slot="caption"><strong>Mock of the Notes tab, with invented notes.</strong> Open another note, or switch between Write, Split and Read.</Fragment>
</Mock>

<style>
  .kn { display: grid; grid-template-columns: 15rem minmax(0, 1fr); min-height: 26rem; }
  .kn-list { margin: 0; padding: var(--s3) 0; border: 0; border-right: 1px solid var(--line); min-width: 0; }
  .kn-list legend { padding: 0 var(--s4); float: left; width: 100%; }
  .kn-group { clear: both; margin: var(--s3) 0 0; padding: var(--s2) var(--s4) var(--s1); font-size: 13px; font-weight: 600; color: var(--muted); }
  .kn-item { position: relative; display: block; padding: var(--s2) var(--s4); border-left: 3px solid transparent; cursor: pointer; }
  .kn-item input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .kn-item:hover { background: var(--surface); }
  .kn-item:has(input:checked) { background: var(--surface); border-left-color: var(--accent); }
  .kn-item:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: -2px; }
  .kn-it { display: block; font-weight: 600; line-height: 1.3; }
  .kn-im { display: block; font-size: 13px; color: var(--muted); }
  .kn-crit { color: var(--accent); font-weight: 600; }

  .kn-doc { min-width: 0; display: flex; flex-direction: column; }
  .kn-ctrl { padding: var(--s3) var(--s4); border-bottom: 1px solid var(--line); }
  .kn-note { display: none; flex: 1; flex-direction: column; }
  .kn:has(input[value="n1"]:checked) [data-note="n1"],
  .kn:has(input[value="n2"]:checked) [data-note="n2"],
  .kn:has(input[value="n3"]:checked) [data-note="n3"] { display: flex; }
  .kn-meta { display: flex; gap: var(--s2); margin: var(--s4) var(--s5) 0; }
  .kn-critchip { color: var(--accent); border-color: var(--accent); }
  .kn-title { font: 600 22px/1.25 var(--body); margin: var(--s2) var(--s5) var(--s3); }
  .kn-panes { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-top: 1px solid var(--line); }
  .kn-src, .kn-prev { padding: var(--s3) var(--s5) var(--s4); min-width: 0; }
  .kn-src { border-right: 1px solid var(--line); background: var(--surface); }
  .kn-src pre { margin: 0; padding: 0; border: 0; background: none; font: 16px/1.65 var(--display); white-space: pre-wrap; overflow: visible; overflow-wrap: anywhere; }
  .kn-prev { font: 16px/1.65 var(--display); }
  .kn-prev h4 { font: 600 16px/1.3 var(--body); margin: var(--s3) 0 var(--s1); color: var(--text); }
  .kn-prev .km-label + h4 { margin-top: 0; }
  .kn-prev p { margin: 0 0 var(--s2); }
  .kn-prev ul, .kn-prev ol { margin: 0 0 var(--s2); padding-left: 1.25em; }
  .kn-prev li { margin: 0; }
  .kn-bar { display: flex; gap: var(--s4); margin: 0; padding: var(--s2) var(--s5); border-top: 1px solid var(--line); font: 13px/1.4 var(--mono); color: var(--muted); }

  .kn:has(input[value="write"]:checked) .kn-prev,
  .kn:has(input[value="read"]:checked) .kn-src { display: none; }
  .kn:has(input[value="write"]:checked) .kn-panes,
  .kn:has(input[value="read"]:checked) .kn-panes { grid-template-columns: minmax(0, 1fr); }
  .kn:has(input[value="write"]:checked) .kn-src pre,
  .kn:has(input[value="read"]:checked) .kn-prev > * { max-width: 68ch; }
  .kn:has(input[value="write"]:checked) .kn-src { border-right: 0; }

  @container (max-width: 720px) {
    .kn { grid-template-columns: minmax(0, 1fr); }
    .kn-list { border-right: 0; border-bottom: 1px solid var(--line); }
    .kn-panes { grid-template-columns: minmax(0, 1fr); }
    .kn-src { border-right: 0; border-bottom: 1px solid var(--line); }
    .kn-meta, .kn-title { margin-left: var(--s4); margin-right: var(--s4); }
    .kn-src, .kn-prev, .kn-bar { padding-left: var(--s4); padding-right: var(--s4); }
  }
</style>
